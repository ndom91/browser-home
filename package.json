{
  "name": "browser-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:demo": "BROWSER_HOME_DEMO=1 vite dev",
    "build": "vite build",
    "start": "node serve.js",
    "reload": "launchctl kickstart -k gui/$(id -u)/com.ndom91.browser-home",
    "typecheck": "tsc --noEmit",
    "build:agenda": "mkdir -p bin && swiftc -O -swift-version 5 calendar/agenda.swift -o bin/agenda -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker calendar/Info.plist",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-openai": "^1.0.1",
    "@tanstack/ai-react": "^1.0.1",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
