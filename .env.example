# Copy to .env (gitignored). Read by `pnpm dev` and `pnpm start`.
# Variables set in the launchd plist take precedence.

# Any OpenAI-compatible endpoint.
LLM_BASE_URL=https://llama-dash.puff.lan/v1
LLM_MODEL=gemma-4-26B-A4B
LLM_API_KEY=

# Name in the greeting. Empty uses the first name on your GitHub profile.
GREETING_NAME=

# Extra GitHub search qualifiers for the PR column, e.g. org:acme or -repo:acme/noisy.
# Empty shows all your PRs.
GH_SEARCH_FILTER=

# Linear workspace slug, as in linear.app/<slug>/issue/ABC-123. Links each PR to the
# Linear issue in its title or description. Empty turns the links off.
LINEAR_WORKSPACE=

# Search engine for the header search box. The query is appended to this URL.
# Read at build time, so run `pnpm build` again after changing it.
VITE_SEARCH_URL=https://www.google.com/search?q=
