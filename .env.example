# Copy to .env (gitignored). Read by `pnpm dev` and `pnpm start`.
# Only secrets live here. Settings are in config.yaml, which reads these with ${VAR}.
# Variables set in the launchd plist take precedence.

LLM_API_KEY=
LINEAR_API_KEY=
# Home Assistant long-lived access token, for mcp.servers in config.yaml.
HA_TOKEN=
# HN's "user" cookie value (not the full Cookie header), for background upvotes.
HN_SESSION_COOKIE=
